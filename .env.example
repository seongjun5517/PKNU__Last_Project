MYSQL_ROOT_PASSWORD=replace_with_a_long_random_password
MYSQL_DATABASE=skin_db
MYSQL_USER=skin
MYSQL_PASSWORD=replace_with_a_different_long_random_password

# Container upload directories
ANALYSIS_IMAGE_DIR=/app/uploads/analysis
PROFILE_IMAGE_DIR=/app/uploads/profile

# Ollama and chatbot
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=1h
OLLAMA_NUM_PARALLEL=2
CHATBOT_NUM_PREDICT=800
CHATBOT_WARMUP_ENABLED=true
CHATBOT_MODEL=gemma3:4b
CHATBOT_EMBEDDING_MODEL=nomic-embed-text
CHATBOT_DATA_DIR=./chatbot-flask/data

# Database connection timeouts (milliseconds)
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000

# Public HTTP port served by the frontend Nginx container
APP_PORT=80
